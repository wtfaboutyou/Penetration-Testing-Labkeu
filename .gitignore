# Dokumen biner hasil build — JANGAN di-commit (ukuran besar, ada salinan di luar repo).
*.docx
*.pdf

# Laporan markdown yang ADA di dalam folder ini ikut ter-commit.
# File .md di luar folder ini (laporan.md, vuln.md di root /root/crack)
# tidak terpengaruh — .gitignore ini hanya berlaku untuk repo ini.
# Kalau nanti laporan.md dipindahkan ke sini, whitelist eksplisit:
# !laporan.md

# Screenshot bukti — ikut di-commit sebagai lampiran laporan.
# Isinya output terminal mentah, memuat kredensial plaintext.
# Kalau butuh repo tanpa kredensial, hapus baris ini lalu git rm -r --cached bukti-pentest/

# Backup
.backup-*/

# Rahasia
.env
*.pem
*.key
__pycache__/
*.pyc
